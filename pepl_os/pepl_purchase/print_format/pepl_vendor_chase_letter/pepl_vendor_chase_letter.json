 "doctype": "Print Format",
 "font_size": 11,
 "html": "<style>\n  /* C2-24 - PEPL letterhead. The bands are reserved with page margins (same as Cycle 1):\n     60 mm top clears the header artwork, 34 mm bottom clears the certification footer.\n     Frappe reads this .print-format rule as the PDF page margins; the PDF button then lays\n     the official letterhead behind every page. */\n  .print-format { margin-top: 60mm; margin-bottom: 34mm; margin-left: 14mm; margin-right: 14mm; }\n  /* ...so inside the page the content must not be pushed in a second time */\n  @media print { .print-format { margin: 0 !important; padding: 0 !important; } }\n  @page { size: A4; }\n  .pepl-doc { font-size: 11px; line-height: 1.35; color: #1f2937; }\n  .pepl-doc h3 { text-align: center; font-size: 15px; margin: 0 0 10px; }\n  .pepl-doc table { width: 100%; border-collapse: collapse; }\n  .pepl-doc .meta td { padding: 1px 0; vertical-align: top; }\n  .pepl-doc .lines th, .pepl-doc .lines td { border: 1px solid #9ca3af; padding: 3px 5px; vertical-align: top; }\n  .pepl-doc .lines th { background: #f3f4f6; font-weight: 600; }\n  .pepl-doc .lines tr { page-break-inside: avoid; }\n  .pepl-doc .num { text-align: right; white-space: nowrap; }\n  .pepl-doc .muted { color: #6b7280; }\n  .pepl-doc .stamp { text-align: center; font-weight: 700; color: #b91c1c; border: 1px solid #b91c1c; padding: 2px; margin-bottom: 8px; }\n  .pepl-doc .signs { margin-top: 36px; }\n  .pepl-doc .signs td { text-align: center; border-top: 1px solid #6b7280; padding-top: 3px; width: 33%; }\n  .pepl-doc .signs td.gap { border: 0; width: 3%; }\n</style>\n<style class=\"hidden-pdf\">\n  /* on screen (preview only): an A4-wide sheet showing the letterhead header and footer.\n     The PDF uses the official letterhead file instead; Frappe drops this block from the PDF. */\n  @media screen {\n    .print-format {\n      margin: 20px auto !important; padding: 60mm 14mm 34mm !important;\n      box-sizing: border-box; width: 210mm; max-width: 210mm !important; min-height: 297mm;\n      border-radius: 0 !important;\n      background-color: #fff !important;\n      background-image: url(\"/assets/pepl_os/images/pepl_letterhead_header.jpg\"), url(\"/assets/pepl_os/images/pepl_letterhead_footer.jpg\") !important;\n      background-repeat: no-repeat, no-repeat !important;\n      background-position: top center, bottom center !important;\n      background-size: 210mm auto, 210mm auto !important;\n    }\n  }\n</style>\n{%- set lines = pepl_chase_lines(doc.name) -%}\n<div class=\"pepl-doc\">\n  <p style=\"text-align: right;\">{{ frappe.format(frappe.utils.today(), {'fieldtype': 'Date'}) }}</p>\n  <p>To,<br><b>{{ doc.supplier_name }}</b>\n  {%- if doc.primary_address %}<br>{{ doc.primary_address }}{% endif %}</p>\n  <p><b>{{ _(\"Subject\") }}: {{ _(\"Pending deliveries against our Purchase Orders\") }}</b></p>\n  <p>{{ _(\"Dear Sir / Madam,\") }}</p>\n  <p>{{ _(\"The following items are pending delivery. Lines marked overdue are past the date you promised. Please confirm the dispatch date for each line by return.\") }}</p>\n  <table class=\"lines\">\n    <thead>\n      <tr>\n        <th>#</th>\n        <th>{{ _(\"Purchase Order\") }}</th>\n        <th>{{ _(\"Item\") }}</th>\n        <th style=\"text-align: right;\">{{ _(\"Pending Qty\") }}</th>\n        <th>{{ _(\"Promised Date\") }}</th>\n        <th style=\"text-align: right;\">{{ _(\"Days Overdue\") }}</th>\n        <th>{{ _(\"Your Revised Date\") }}</th>\n      </tr>\n    </thead>\n    <tbody>\n      {%- for l in lines %}\n      <tr>\n        <td>{{ loop.index }}</td>\n        <td>{{ l.purchase_order }}</td>\n        <td>{{ l.item_code }}{% if l.item_name and l.item_name != l.item_code %}<br><small>{{ l.item_name }}</small>{% endif %}</td>\n        <td style=\"text-align: right;\">{{ frappe.format(l.pending_qty, {'fieldtype': 'Float'}) }} {{ l.uom or \"\" }}</td>\n        <td>{{ frappe.format(l.promised_date, {'fieldtype': 'Date'}) }}</td>\n        <td style=\"text-align: right;\">{% if l.days_overdue %}<b>{{ l.days_overdue }}</b>{% else %}-{% endif %}</td>\n        <td>{{ frappe.format(l.revised_date, {'fieldtype': 'Date'}) if l.revised_date else \"\" }}</td>\n      </tr>\n      {%- else %}\n      <tr><td colspan=\"7\">{{ _(\"Nothing is pending.\") }}</td></tr>\n      {%- endfor %}\n    </tbody>\n  </table>\n  <p>{{ _(\"Thank you for your prompt attention.\") }}</p>\n  <p>{{ _(\"For\") }} {{ lines[0].company if lines else \"\" }}<br><br>{{ _(\"Purchase Department\") }}</p>\n</div>\n",
