 "html": "<style>\n  /* C2-24 - PEPL letterhead. The bands are reserved with page margins (same as Cycle 1):\n     60 mm top clears the header artwork, 34 mm bottom clears the certification footer.\n     Frappe reads this .print-format rule as the PDF page margins; the PDF button then lays\n     the official letterhead behind every page. */\n  .print-format { margin-top: 60mm; margin-bottom: 34mm; margin-left: 14mm; margin-right: 14mm; }\n  /* ...so inside the page the content must not be pushed in a second time */\n  @media print { .print-format { margin: 0 !important; padding: 0 !important; } }\n  /* on screen: an A4 sheet with the letterhead bands left empty */\n  @media screen { .print-format { margin: 20px auto !important; padding: 60mm 14mm 34mm !important; } }\n  @page { size: A4; }\n  .pepl-doc { font-size: 11px; line-height: 1.35; color: #1f2937; }\n  .pepl-doc h3 { text-align: center; font-size: 15px; letter-spacing: 1px; margin: 0 0 10px; }\n  .pepl-doc table { width: 100%; border-collapse: collapse; }\n  .pepl-doc .meta td { padding: 1px 0; vertical-align: top; }\n  .pepl-doc .lines th, .pepl-doc .lines td { border: 1px solid #9ca3af; padding: 3px 5px; vertical-align: top; }\n  .pepl-doc .lines th { background: #f3f4f6; font-weight: 600; }\n  .pepl-doc .lines tr { page-break-inside: avoid; }\n  .pepl-doc .num { text-align: right; white-space: nowrap; }\n  .pepl-doc .muted { color: #6b7280; }\n  .pepl-doc .stamp { text-align: center; font-weight: 700; color: #b91c1c; border: 1px solid #b91c1c; padding: 2px; margin-bottom: 8px; }\n  .pepl-doc .signs { margin-top: 36px; }\n  .pepl-doc .signs td { text-align: center; border-top: 1px solid #6b7280; padding-top: 3px; width: 33%; }\n  .pepl-doc .signs td.gap { border: 0; width: 3%; }\n</style>\n<style>\n  /* C2-24 - PEPL letterhead. The bands are reserved with page margins (same as Cycle 1):\n     60 mm top clears the header artwork, 34 mm bottom clears the certification footer.\n     The PDF button lays the official letterhead behind every page. */\n  .print-format { margin-top: 60mm; margin-bottom: 34mm; margin-left: 14mm; margin-right: 14mm; }\n  @page { size: A4; }\n  .pepl-doc { font-size: 11px; line-height: 1.35; color: #1f2937; }\n  .pepl-doc h3 { text-align: center; font-size: 15px; letter-spacing: 1px; margin: 0 0 10px; }\n  .pepl-doc table { width: 100%; border-collapse: collapse; }\n  .pepl-doc .meta td { padding: 1px 0; vertical-align: top; }\n  .pepl-doc .lines th, .pepl-doc .lines td { border: 1px solid #9ca3af; padding: 3px 5px; vertical-align: top; }\n  .pepl-doc .lines th { background: #f3f4f6; font-weight: 600; }\n  .pepl-doc .lines tr { page-break-inside: avoid; }\n  .pepl-doc .num { text-align: right; white-space: nowrap; }\n  .pepl-doc .muted { color: #6b7280; }\n  .pepl-doc .stamp { text-align: center; font-weight: 700; color: #b91c1c; border: 1px solid #b91c1c; padding: 2px; margin-bottom: 8px; }\n  .pepl-doc .signs { margin-top: 36px; }\n  .pepl-doc .signs td { text-align: center; border-top: 1px solid #6b7280; padding-top: 3px; width: 33%; }\n  .pepl-doc .signs td.gap { border: 0; width: 3%; }\n</style>\n<div class=\"pepl-doc\">\n  <h3>RETURNABLE MATERIAL CHALLAN - CUSTOMER MATERIAL RETURNED</h3>\n  {%- set so = frappe.db.get_value(\"Sales Order\", doc.custom_sales_order, [\"customer_name\", \"po_no\"], as_dict=True) if doc.custom_sales_order else None %}\n  <table style=\"width:100%; margin-bottom: 10px;\">\n    <tr><td><b>Challan No.</b> {{ doc.name }}</td><td style=\"text-align:right;\"><b>Date</b> {{ frappe.format(doc.posting_date, {'fieldtype': 'Date'}) }}</td></tr>\n    <tr><td><b>To</b> {{ so.customer_name if so else '' }}</td><td style=\"text-align:right;\"><b>Against Sales Order</b> {{ doc.custom_sales_order or '' }}{% if so and so.po_no %} (PO {{ so.po_no }}){% endif %}</td></tr>\n  </table>\n  <table class=\"lines\">\n    <thead><tr><th>#</th><th>Material</th><th>Heat / Batch</th><th>From</th><th style=\"text-align:right;\">Qty</th><th>UOM</th></tr></thead>\n    <tbody>\n    {%- for row in doc.items %}\n      <tr><td>{{ row.idx }}</td><td>{{ row.item_name or row.item_code }}</td><td>{{ row.custom_heat_number or row.batch_no or '' }}</td>\n      <td>{{ row.s_warehouse }}</td><td style=\"text-align:right;\">{{ frappe.format(row.qty, {'fieldtype': 'Float'}) }}</td><td>{{ row.uom }}</td></tr>\n    {%- endfor %}\n    </tbody>\n  </table>\n  <p>Customer-supplied material returned unused or as scrap, as instructed by the customer. Not a sale.</p>\n  <p style=\"margin-top: 40px;\"><span style=\"display:inline-block; width:32%;\">Stores</span><span style=\"display:inline-block; width:32%;\">Security</span><span style=\"display:inline-block; width:32%;\">Received by</span></p>\n</div>",
