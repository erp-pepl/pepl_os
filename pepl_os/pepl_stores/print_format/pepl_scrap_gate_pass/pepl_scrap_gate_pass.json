 "doctype": "Print Format",
 "font_size": 13,
 "html": "<div style=\"font-size: 13px;\">\n  <h3 style=\"text-align:center; margin: 0 0 4px;\">SCRAP GATE PASS</h3>\n  <p style=\"text-align:center; margin: 0 0 12px;\">{{ doc.company }}</p>\n  <table style=\"width:100%; margin-bottom: 10px;\">\n    <tr><td><b>Gate Pass No.</b> {{ doc.name }}</td><td style=\"text-align:right;\"><b>Date</b> {{ frappe.format(doc.sale_date, {'fieldtype': 'Date'}) }}</td></tr>\n    <tr><td><b>Buyer</b> {{ doc.buyer_name or doc.buyer }}</td><td style=\"text-align:right;\"><b>Vehicle No.</b> {{ doc.vehicle_number }}</td></tr>\n  </table>\n  <table class=\"table table-bordered\" style=\"width:100%;\">\n    <thead><tr><th>#</th><th>Scrap</th><th>From</th><th style=\"text-align:right;\">Kg</th><th style=\"text-align:right;\">Rate / Kg</th><th style=\"text-align:right;\">Amount</th></tr></thead>\n    <tbody>\n    {%- for row in doc.items %}\n      <tr><td>{{ row.idx }}</td><td>{{ row.item_name or row.scrap_item }}{% if row.sales_order %}<br><small>Customer material, SO {{ row.sales_order }}</small>{% endif %}</td>\n      <td>{{ row.warehouse }}</td><td style=\"text-align:right;\">{{ frappe.format(row.kg, {'fieldtype': 'Float'}) }}</td>\n      <td style=\"text-align:right;\">{{ frappe.format(row.rate, {'fieldtype': 'Currency'}) }}</td><td style=\"text-align:right;\">{{ frappe.format(row.amount, {'fieldtype': 'Currency'}) }}</td></tr>\n    {%- endfor %}\n      <tr><td colspan=\"3\"><b>Total</b></td><td style=\"text-align:right;\"><b>{{ frappe.format(doc.total_kg, {'fieldtype': 'Float'}) }}</b></td><td></td><td style=\"text-align:right;\"><b>{{ frappe.format(doc.total_amount, {'fieldtype': 'Currency'}) }}</b></td></tr>\n    </tbody>\n  </table>\n  <p style=\"margin-top: 40px;\"><span style=\"display:inline-block; width:32%;\">Stores</span><span style=\"display:inline-block; width:32%;\">Security</span><span style=\"display:inline-block; width:32%;\">Driver / Buyer</span></p>\n</div>",
