 "font_size": 11,
 "html": "<style>\n  /* C2-24 - PEPL letterhead. The bands are reserved with page margins (same as Cycle 1):\n     60 mm top clears the header artwork, 34 mm bottom clears the certification footer.\n     Frappe reads this .print-format rule as the PDF page margins; the PDF button then lays\n     the official letterhead behind every page. */\n  .print-format { margin-top: 60mm; margin-bottom: 34mm; margin-left: 14mm; margin-right: 14mm; }\n  /* ...so inside the page the content must not be pushed in a second time */\n  @media print { .print-format { margin: 0 !important; padding: 0 !important; } }\n  @page { size: A4; }\n  .pepl-doc { font-size: 11px; line-height: 1.35; color: #1f2937; }\n  .pepl-doc h3 { text-align: center; font-size: 15px; margin: 0 0 10px; }\n  .pepl-doc table { width: 100%; border-collapse: collapse; }\n  .pepl-doc .meta td { padding: 1px 0; vertical-align: top; }\n  .pepl-doc .lines th, .pepl-doc .lines td { border: 1px solid #9ca3af; padding: 3px 5px; vertical-align: top; }\n  .pepl-doc .lines th { background: #f3f4f6; font-weight: 600; }\n  .pepl-doc .lines tr { page-break-inside: avoid; }\n  .pepl-doc .num { text-align: right; white-space: nowrap; }\n  .pepl-doc .muted { color: #6b7280; }\n  .pepl-doc .stamp { text-align: center; font-weight: 700; color: #b91c1c; border: 1px solid #b91c1c; padding: 2px; margin-bottom: 8px; }\n  .pepl-doc .signs { margin-top: 36px; }\n  .pepl-doc .signs td { text-align: center; border-top: 1px solid #6b7280; padding-top: 3px; width: 33%; }\n  .pepl-doc .signs td.gap { border: 0; width: 3%; }\n</style>\n<style class=\"hidden-pdf\">\n  /* on screen (preview only): an A4-wide sheet showing the letterhead header and footer.\n     The PDF uses the official letterhead file instead; Frappe drops this block from the PDF. */\n  @media screen {\n    .print-format {\n      margin: 20px auto !important; padding: 60mm 14mm 34mm !important;\n      box-sizing: border-box; width: 210mm; max-width: 210mm !important; min-height: 297mm;\n      border-radius: 0 !important;\n      background-color: #fff !important;\n      background-image: url(\"/assets/pepl_os/images/pepl_letterhead_header.jpg\"), url(\"/assets/pepl_os/images/pepl_letterhead_footer.jpg\") !important;\n      background-repeat: no-repeat, no-repeat !important;\n      background-position: top center, bottom center !important;\n      background-size: 210mm auto, 210mm auto !important;\n    }\n  }\n</style>\n<div class=\"pepl-doc\">\n  <h3>SCRAP GATE PASS</h3>\n  <table style=\"width:100%; margin-bottom: 10px;\">\n    <tr><td><b>Gate Pass No.</b> {{ doc.name }}</td><td style=\"text-align:right;\"><b>Date</b> {{ frappe.format(doc.sale_date, {'fieldtype': 'Date'}) }}</td></tr>\n    <tr><td><b>Buyer</b> {{ doc.buyer_name or doc.buyer }}</td><td style=\"text-align:right;\"><b>Vehicle No.</b> {{ doc.vehicle_number }}</td></tr>\n  </table>\n  <table class=\"lines\">\n    <thead><tr><th>#</th><th>Scrap</th><th>From</th><th style=\"text-align:right;\">Kg</th><th style=\"text-align:right;\">Rate / Kg</th><th style=\"text-align:right;\">Amount</th></tr></thead>\n    <tbody>\n    {%- for row in doc.items %}\n      <tr><td>{{ row.idx }}</td><td>{{ row.item_name or row.scrap_item }}{% if row.sales_order %}<br><small>Customer material, SO {{ row.sales_order }}</small>{% endif %}</td>\n      <td>{{ row.warehouse }}</td><td style=\"text-align:right;\">{{ frappe.format(row.kg, {'fieldtype': 'Float'}) }}</td>\n      <td style=\"text-align:right;\">{{ frappe.format(row.rate, {'fieldtype': 'Currency'}) }}</td><td style=\"text-align:right;\">{{ frappe.format(row.amount, {'fieldtype': 'Currency'}) }}</td></tr>\n    {%- endfor %}\n      <tr><td colspan=\"3\"><b>Total</b></td><td style=\"text-align:right;\"><b>{{ frappe.format(doc.total_kg, {'fieldtype': 'Float'}) }}</b></td><td></td><td style=\"text-align:right;\"><b>{{ frappe.format(doc.total_amount, {'fieldtype': 'Currency'}) }}</b></td></tr>\n    </tbody>\n  </table>\n  <p style=\"margin-top: 40px;\"><span style=\"display:inline-block; width:32%;\">Stores</span><span style=\"display:inline-block; width:32%;\">Security</span><span style=\"display:inline-block; width:32%;\">Driver / Buyer</span></p>\n</div>",
