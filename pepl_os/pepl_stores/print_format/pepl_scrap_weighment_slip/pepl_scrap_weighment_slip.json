 "doctype": "Print Format",
 "font_size": 11,
 "html": "<style>\n  /* C2-24 - PEPL letterhead. The bands are reserved with page margins (same as Cycle 1):\n     60 mm top clears the header artwork, 34 mm bottom clears the certification footer.\n     Frappe reads this .print-format rule as the PDF page margins; the PDF button then lays\n     the official letterhead behind every page. */\n  .print-format { margin-top: 60mm; margin-bottom: 34mm; margin-left: 14mm; margin-right: 14mm; }\n  /* ...so inside the page the content must not be pushed in a second time */\n  @media print { .print-format { margin: 0 !important; padding: 0 !important; } }\n  @page { size: A4; }\n  .pepl-doc { font-size: 11px; line-height: 1.35; color: #1f2937; }\n  .pepl-doc h3 { text-align: center; font-size: 15px; margin: 0 0 10px; }\n  .pepl-doc table { width: 100%; border-collapse: collapse; }\n  .pepl-doc .meta td { padding: 1px 0; vertical-align: top; }\n  .pepl-doc .lines th, .pepl-doc .lines td { border: 1px solid #9ca3af; padding: 3px 5px; vertical-align: top; }\n  .pepl-doc .lines th { background: #f3f4f6; font-weight: 600; }\n  .pepl-doc .lines tr { page-break-inside: avoid; }\n  .pepl-doc .num { text-align: right; white-space: nowrap; }\n  .pepl-doc .muted { color: #6b7280; }\n  .pepl-doc .stamp { text-align: center; font-weight: 700; color: #b91c1c; border: 1px solid #b91c1c; padding: 2px; margin-bottom: 8px; }\n  .pepl-doc .signs { margin-top: 36px; }\n  .pepl-doc .signs td { text-align: center; border-top: 1px solid #6b7280; padding-top: 3px; width: 33%; }\n  .pepl-doc .signs td.gap { border: 0; width: 3%; }\n</style>\n<style class=\"hidden-pdf\">\n  /* on screen (preview only): an A4-wide sheet showing the letterhead header and footer.\n     The PDF uses the official letterhead file instead; Frappe drops this block from the PDF. */\n  @media screen {\n    .print-format {\n      margin: 20px auto !important; padding: 60mm 14mm 34mm !important;\n      box-sizing: border-box; width: 210mm; max-width: 210mm !important; min-height: 297mm;\n      border-radius: 0 !important;\n      background-color: #fff !important;\n      background-image: url(\"/assets/pepl_os/images/pepl_letterhead_header.jpg\"), url(\"/assets/pepl_os/images/pepl_letterhead_footer.jpg\") !important;\n      background-repeat: no-repeat, no-repeat !important;\n      background-position: top center, bottom center !important;\n      background-size: 210mm auto, 210mm auto !important;\n    }\n  }\n</style>\n<div class=\"pepl-doc\">\n  {%- if doc.docstatus == 0 %}<div class=\"stamp\">{{ _(\"DRAFT\") }}</div>{% endif %}\n  {%- if doc.docstatus == 2 %}<div class=\"stamp\">{{ _(\"CANCELLED\") }}</div>{% endif %}\n  <h3>{{ _(\"SCRAP WEIGHMENT SLIP\") }}</h3>\n  <table class=\"meta\" style=\"margin-bottom: 8px;\">\n    <tr><td><b>{{ _(\"Slip No.\") }}</b> {{ doc.name }}</td><td style=\"text-align: right;\"><b>{{ _(\"Date\") }}</b> {{ frappe.format(doc.weighment_date, {\"fieldtype\": \"Date\"}) }}{% if doc.shift %} &nbsp; <b>{{ _(\"Shift\") }}</b> {{ doc.shift }}{% endif %}</td></tr>\n    <tr><td><b>{{ _(\"Workshop\") }}</b> {{ doc.workshop or \"\" }}{% if doc.machine_group %} &nbsp; <b>{{ _(\"Machine group\") }}</b> {{ doc.machine_group }}{% endif %}</td><td style=\"text-align: right;\"><b>{{ _(\"Source\") }}</b> {{ doc.source }}</td></tr>\n    {%- if doc.sales_order %}<tr><td colspan=\"2\"><b>{{ _(\"Customer material, Sales Order\") }}</b> {{ doc.sales_order }} - {{ frappe.db.get_value(\"Sales Order\", doc.sales_order, \"customer_name\") or \"\" }}</td></tr>{% endif %}\n  </table>\n  <table class=\"lines\">\n    <thead><tr><th>{{ _(\"Scrap\") }}</th><th class=\"num\">{{ _(\"Gross Kg\") }}</th><th class=\"num\">{{ _(\"Tare Kg\") }}</th><th class=\"num\">{{ _(\"Net Kg\") }}</th><th class=\"num\">{{ _(\"Rate / Kg\") }}</th><th class=\"num\">{{ _(\"Value\") }}</th></tr></thead>\n    <tbody>\n      <tr>\n        <td><b>{{ doc.scrap_item }}</b>{% if doc.item_name and doc.item_name != doc.scrap_item %} - {{ doc.item_name }}{% endif %}</td>\n        <td class=\"num\">{{ frappe.format(doc.gross_kg, {\"fieldtype\": \"Float\"}) }}</td>\n        <td class=\"num\">{{ frappe.format(doc.tare_kg, {\"fieldtype\": \"Float\"}) }}</td>\n        <td class=\"num\"><b>{{ frappe.format(doc.net_kg, {\"fieldtype\": \"Float\"}) }}</b></td>\n        <td class=\"num\">{{ frappe.format(doc.rate_applied, {\"fieldtype\": \"Currency\"}) }}</td>\n        <td class=\"num\">{{ frappe.format(doc.amount, {\"fieldtype\": \"Currency\"}) }}</td>\n      </tr>\n    </tbody>\n  </table>\n  <p style=\"margin-top: 6px;\"><b>{{ _(\"Taken into\") }}</b> {{ doc.warehouse or \"\" }}{% if doc.stock_entry %} &nbsp; <b>{{ _(\"Stock Entry\") }}</b> {{ doc.stock_entry }}{% endif %}</p>\n  {%- if doc.sales_order %}<p>{{ _(\"Customer-supplied material: held at zero value for the customer, not PEPL's stock.\") }}</p>{% endif %}\n  <table class=\"signs\"><tr>\n    <td>{{ _(\"Weighed by\") }}{% if doc.weighed_by %}<br>{{ frappe.db.get_value(\"User\", doc.weighed_by, \"full_name\") or doc.weighed_by }}{% endif %}</td><td class=\"gap\"></td>\n    <td>{{ _(\"Workshop supervisor\") }}</td><td class=\"gap\"></td>\n    <td>{{ _(\"Stores\") }}</td>\n  </tr></table>\n</div>\n",
 "idx": 0,
