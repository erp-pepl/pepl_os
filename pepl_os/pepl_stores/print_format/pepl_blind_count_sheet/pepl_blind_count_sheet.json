 "font_size": 13,
 "html": "<div style=\"font-size: 13px;\">\n  <h3 style=\"text-align:center; margin: 0 0 4px;\">BLIND COUNT SHEET</h3>\n  <p style=\"text-align:center; margin: 0 0 12px;\">{{ doc.company }}</p>\n  <table style=\"width:100%; margin-bottom: 10px;\">\n    <tr><td><b>Count No.</b> {{ doc.name }}</td><td style=\"text-align:right;\"><b>Date</b> {{ frappe.format(doc.count_date, {'fieldtype': 'Date'}) }}</td></tr>\n    <tr><td><b>Store</b> {{ doc.warehouse }}</td><td style=\"text-align:right;\"><b>Counted by</b> ____________________</td></tr>\n  </table>\n  <table class=\"table table-bordered\" style=\"width:100%;\">\n    <thead><tr><th style=\"width:5%;\">#</th><th>Item</th><th>Batch / Heat</th><th>Location</th><th style=\"width:10%;\">UOM</th><th style=\"width:18%;\">Counted Qty</th></tr></thead>\n    <tbody>\n    {%- for row in doc.items %}\n      <tr><td>{{ row.idx }}</td><td>{{ row.item_code }}<br><small>{{ row.item_name or '' }}</small></td><td>{{ row.batch_no or '' }}</td>\n      <td>{{ doc.warehouse }}</td><td>{{ frappe.db.get_value('Item', row.item_code, 'stock_uom') }}</td><td style=\"height: 28px;\"></td></tr>\n    {%- endfor %}\n    </tbody>\n  </table>\n  <p>Count what is physically there. The book quantity is deliberately not shown.</p>\n  <p style=\"margin-top: 40px;\"><span style=\"display:inline-block; width:48%;\">Counted by</span><span style=\"display:inline-block; width:48%;\">Checked by</span></p>\n</div>",
